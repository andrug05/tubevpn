{
  "schema": 1,
  "components": [
    {
      "id": "jap_ridetube",
      "kind": "app",
      "path": "apps/jap_ridetube",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "jap-ridetube-d": "0.6.3",
        "mgu-render": "0.6.11",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/make_icon.js",
          "kit/tools/oapgen",
          "oap-sdk"
        ]
      }
    },
    {
      "id": "jap-ridetube-d",
      "kind": "tool",
      "path": "native/jap-ridetube-d",
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}
